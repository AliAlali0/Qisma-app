# استخدام نسخة خفيفة وآمنة من Node.js
FROM node:18-alpine

# إنشاء مجلد العمل داخل حاوية الدوكر
WORKDIR /app

# نسخ ملفات الاعتماديات أولاً لسرعة التحميل
COPY package*.json ./

# تثبيت الحزم المطلوبة
RUN npm install

# نسخ باقي ملفات الباك إند
COPY . .

# المنفذ الذي سيعمل عليه السيرفر داخل الحاوية
EXPOSE 3000

# أمر تشغيل السيرفر
CMD ["node", "server.js"]